<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jdkxx.trader</groupId>
        <artifactId>trader</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>trader-gateway-ibkr</artifactId>
    <name>trader-gateway-ibkr</name>
    <description>盈透 TWS API 适配器：com.ib.client.* 只允许出现在本模块，边界是 mapper 包。职责：账户资金、持仓盈亏、下单</description>
    <dependencies>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          TWS API 与其 protobuf 运行时。optional：编译期只有本模块能 import com.ib.client.*，
          下游模块拿不到；trader-app 另有 runtime 声明只为打进 fat jar。
        -->
        <dependency>
            <groupId>com.interactivebrokers</groupId>
            <artifactId>tws-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
