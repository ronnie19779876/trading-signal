<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jdkxx.trader</groupId>
        <artifactId>trader</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>trader-gateway-ibkr</artifactId>
    <name>trader-gateway-ibkr</name>
    <description>盈透 TWS API 适配器：com.ib.client.* 只允许出现在本模块，边界是 mapper 包。职责：账户资金、持仓盈亏、下单</description>
    <dependencies>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          TWS API and its protobuf runtime. optional: at compile time only this module can import com.ib.client.*;
          downstream modules do not see it. trader-app has a separate runtime declaration solely so the jars end up
          in the fat jar (remove it and the build still passes, but startup fails with NoClassDefFoundError).
        -->
        <dependency>
            <groupId>com.interactivebrokers</groupId>
            <artifactId>tws-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
