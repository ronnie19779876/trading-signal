# ---- build output ----
target/
.flattened-pom.xml
*.class
*.log
logs/
dist/

# ---- third-party SDK binaries: their licenses forbid redistribution; always installed locally by scripts/install-sdks.sh ----
*.jar
!.mvn/wrapper/maven-wrapper.jar
sdk/tws-api/*.zip
sdk/tws-api/IBJts/

# ---- IDE and OS files ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
.claude/settings.local.json
.claude/launch.json
# Editor swap and backup copies: a copy of a secret file (deploy/config/trader.env~, .trader.env.swp)
# does not match that file's own ignore rule. check-secrets.sh also rejects them when force-added.
*.swp
*.swo
*~
*.bak
*.orig

# ---- secret configuration: passwords, gateway address/port/client-id, trading-password MD5, API keys; never committed ----
config/secrets.yml
config/*.env
deploy/config/trader.env
*.env
!*.env.example
# private key files (Futu RSA etc.)
*.pem
*.key

# ---- frontend: dependencies and build output are not committed; the output is produced by scripts/package.sh and bundled into the jar ----
trader-web/node_modules/
trader-web/dist/
trader-app/src/main/resources/static/

# Working files of the Postman client (Git integration): it splits the generated JSON collection into a
# directory tree and stores environments as yaml, which conflicts with what build_collection.py generates.
# The JSON collection is authoritative; the client's files are not committed.
docs/postman/.postman/
docs/postman/postman/
docs/postman/trading-signal/
docs/postman/*.environment.yaml

