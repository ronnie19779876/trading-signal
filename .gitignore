# ---- 构建产物 ----
target/
.flattened-pom.xml
*.class
*.log
logs/
dist/

# ---- 第三方 SDK 的二进制：许可证不允许再分发，一律由 scripts/install-sdks.sh 本地安装 ----
*.jar
!.mvn/wrapper/maven-wrapper.jar
sdk/tws-api/*.zip
sdk/tws-api/IBJts/

# ---- IDE 与系统文件 ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
.claude/settings.local.json

# ---- 敏感配置：密码、网关地址/端口/client-id、交易密码 MD5、API key，永不入库 ----
config/secrets.yml
config/*.env
deploy/config/trader.env
*.env
!*.env.example

# ---- 前端：依赖与构建产物不入库，产物由 scripts/package.sh 生成并打进 jar ----
trader-web/node_modules/
trader-web/dist/
trader-app/src/main/resources/static/

# Postman 客户端（Git 集成）的工作产物：它会把生成的 JSON 集合拆成目录树并改用 yaml 存环境变量，
# 与 build_collection.py 的生成物冲突。集合以 JSON 为准，客户端产物不入库。
docs/postman/.postman/
docs/postman/postman/
docs/postman/trading-signal/
docs/postman/*.environment.yaml
