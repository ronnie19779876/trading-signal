<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jdkxx.trader</groupId>
    <artifactId>trader</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>trading-signal</name>
    <description>基于 AI 大模型的美股量化交易系统：盈透（持仓与执行）+ 富途（行情、基本面与信号）</description>

    <!--
      Dependency direction (module order is dependency order; never point backwards):
        app → { core, gateway-ibkr, gateway-futu }
        core → { gateway-api, storage, ai }
        gateway-ibkr / gateway-futu → gateway-api → domain → common
        storage → common ; ai → common
      Vendor SDK isolation: com.ib.client.* only in trader-gateway-ibkr; com.futu.openapi.* only in
      trader-gateway-futu; com.openai.* only in trader-ai. All three use <optional>true</optional> to cut
      transitivity; trader-app declares them again with runtime scope purely for packaging (remove that and
      the build still passes, but startup fails with NoClassDefFoundError).
    -->
    <modules>
        <module>trader-common</module>
        <module>trader-domain</module>
        <module>trader-gateway-api</module>
        <module>trader-gateway-ibkr</module>
        <module>trader-gateway-futu</module>
        <module>trader-storage</module>
        <module>trader-ai</module>
        <module>trader-core</module>
        <module>trader-app</module>
    </modules>

    <properties>
        <!-- The version is changed here and only here. Development/testing always uses -SNAPSHOT; a release drops
             SNAPSHOT and gets a tag. Only release versions may be deployed to production. Rules: README, versioning section -->
        <revision>3.5.2-SNAPSHOT</revision>

        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.5.13</spring-boot.version>

        <!--
          IBKR TWS API: not published to Maven Central by IBKR; scripts/install-sdks.sh installs it into the local
          repository (the jar is not committed; its license forbids redistribution).
          10.30.01 bundles protobuf generated classes (gencode 4.29.5), so the runtime needs protobuf-java 4.x (≥4.29.5).
        -->
        <tws-api.version>10.30.01</tws-api.version>
        <protobuf-java.version>4.32.0</protobuf-java.version>
        <!--
          The Futu SDK's protobuf generated code was produced by 3.5.1 and cannot coexist with the 4.x runtime
          above (measured: NoSuchMethodError). So nothing depends on com.futunn.openapi:futu-api directly;
          the relocated build from sdk/futu-api-shaded is used instead
          (com.google.protobuf → org.jdkxx.trader.shaded.futu.protobuf), also installed by scripts/install-sdks.sh.
        -->
        <futu-api-shaded.version>10.10.7008</futu-api-shaded.version>
        <openai-java.version>4.52.0</openai-java.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.interactivebrokers</groupId>
                <artifactId>tws-api</artifactId>
                <version>${tws-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>futu-api-shaded</artifactId>
                <version>${futu-api-shaded.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openai</groupId>
                <artifactId>openai-java</artifactId>
                <version>${openai-java.version}</version>
            </dependency>

            <!-- this project's modules -->
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-gateway-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-gateway-ibkr</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-gateway-futu</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jdkxx.trader</groupId>
                <artifactId>trader-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- test stack shared by all modules (JUnit 5 / AssertJ / Mockito) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Makes ${revision} concrete: on install/deploy the resolved version is written into .flattened-pom.xml (gitignored) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
