# Secrets for local development. Copy to secrets.yml and fill in the real values:
#     cp config/secrets.yml.example config/secrets.yml && chmod 600 config/secrets.yml
# WARNING: secrets.yml is excluded by .gitignore; never commit it, and never copy its values into any
# committed file or document.
#
# Purpose: IDEA launched from the Dock/Finder does not inherit shell environment variables, so this file is
# the second source, meant for IDEA; the command line ./scripts/run-local.sh uses environment variables,
# and the database password can also come straight from ~/.pgpass (leave it empty).

spring:
  datasource:
    # Empty = read from ~/.pgpass (recommended; the same file psql uses)
    password:

trader:
  ibkr:
    # When enabled, connects when the application starts (auto-connect defaults to true). Through an SSH
    # tunnel the host is 127.0.0.1; each instance needs its own client-id, and a clash kicks the other
    # one offline (reports 326). Which id each instance uses is not written here: locally see
    # config/secrets.yml, in production see deploy/config/trader.env on the server.
    enabled: false
    host:
    port:
    client-id:
    # Optional: when set, it must be in the gateway's managed-accounts list, otherwise the gateway goes to ERROR
    account:
  futu:
    enabled: false
    # Through an SSH tunnel the host is 127.0.0.1
    host:
    port:
    # When OpenD listens on a non-local address, the trading API requires RSA encryption: set encrypt: true
    # and give the path of a PKCS#1 private key file
    # encrypt: true
    # rsa-private-key-file: /path/to/opend_rsa.pem
  ai:
    # OpenAI API key. The command line / server use the environment variable OPENAI_API_KEY; this is for IDEA
    api-key:
