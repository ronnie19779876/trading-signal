# 本机开发的敏感配置。复制成 secrets.yml 后填入真实值：
#     cp config/secrets.yml.example config/secrets.yml && chmod 600 config/secrets.yml
# ⚠️ secrets.yml 已被 .gitignore 排除，不要提交；也不要把这里的值抄进任何入库文件或文档。
#
# 用途：从 Dock/Finder 启动的 IDEA 不继承 shell 环境变量，这个文件是给 IDEA 用的第二条来源；
# 命令行 ./scripts/run-local.sh 走环境变量，数据库密码还可以直接由 ~/.pgpass 提供（留空即可）。

spring:
  datasource:
    # 留空 = 从 ~/.pgpass 读取（推荐，与 psql 共用同一份）
    password:

trader:
  ibkr:
    # 启用后随应用启动连接（auto-connect 默认 true）。经 SSH 隧道时 host 为 127.0.0.1；
    # client-id 每个实例独占（开发 12 / 生产 2 / 临时验证 91~99），撞车会把对方踢下线。
    enabled: false
    host:
    port:
    client-id:
    # 可选：配置了就必须在网关的受管账户列表里，否则网关进入 ERROR
    account:
  futu:
    enabled: false
    # 经 SSH 隧道时 host 为 127.0.0.1
    host:
    port:
    # OpenD 监听非本地地址时交易接口强制 RSA 加密：encrypt: true 并给出 PKCS#1 私钥文件路径
    # encrypt: true
    # rsa-private-key-file: /path/to/opend_rsa.pem
  ai:
    # OpenAI API key。命令行/服务器走环境变量 OPENAI_API_KEY，这里是给 IDEA 用的
    api-key:
