<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jdkxx.trader</groupId>
        <artifactId>trader</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>trader-gateway-futu</artifactId>
    <name>trader-gateway-futu</name>
    <description>富途 OpenD 适配器：com.futu.openapi.* 只允许出现在本模块，边界是 mapper 包。职责：K 线、基本面、实时订阅</description>
    <dependencies>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          The relocated Futu SDK (see sdk/futu-api-shaded). optional: only this module can import it at compile time;
          trader-app has a separate runtime declaration solely to package it into the fat jar (bcprov/bcpkix come
          along transitively).
        -->
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>futu-api-shaded</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
