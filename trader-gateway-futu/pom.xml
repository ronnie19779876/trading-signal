<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jdkxx.trader</groupId>
        <artifactId>trader</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>trader-gateway-futu</artifactId>
    <name>trader-gateway-futu</name>
    <description>富途 OpenD 适配器：com.futu.openapi.* 只允许出现在本模块，边界是 mapper 包。职责：K 线、基本面、实时订阅</description>
    <dependencies>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
          重定位后的富途 SDK（见 sdk/futu-api-shaded）。optional：编译期只有本模块能 import；
          trader-app 另有 runtime 声明只为打进 fat jar（bcprov/bcpkix 随之传递）。
        -->
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>futu-api-shaded</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
