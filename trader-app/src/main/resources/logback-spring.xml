<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging: the console works as before (bin/trader.sh redirects it to logs/console.log), plus a separate file that
  rolls daily.

  Why rolling: console.log is a nohup redirect that only grows and never rolls; it also lives in the version
  directory, so cleaning up old version directories after an upgrade deletes the logs with them. During one review
  the previous night's increment logs could no longer be found because of this.
  The rolling file is independent of console.log and keeps 14 days, enough to cover one after-the-fact
  investigation.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/trading-signal.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/trading-signal.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
