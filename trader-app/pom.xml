<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jdkxx.trader</groupId>
        <artifactId>trader</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>trader-app</artifactId>
    <name>trader-app</name>
    <description>Spring Boot 启动、REST 接口、静态前端；把两家券商适配器装配进核心；打 fat jar</description>
    <dependencies>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-core</artifactId>
        </dependency>
        <!-- Broker adapters are plugged in at this layer: core only knows the gateway-api interfaces -->
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-ibkr</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>trader-gateway-futu</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          The three vendor SDKs are marked optional in their own modules, so they are not transitive to here. The
          runtime declarations below exist only to package them into the fat jar; the runtime scope is not on the
          compile classpath, so this module still cannot import them and the module boundary is preserved.
          WARNING: removing any of them still builds, but the resulting jar lacks the SDK and fails at startup with
          NoClassDefFoundError.
        -->
        <dependency>
            <groupId>com.interactivebrokers</groupId>
            <artifactId>tws-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.jdkxx.trader</groupId>
            <artifactId>futu-api-shaded</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Fixed artifact name: scripts and the systemd unit all reference trader-app.jar -->
        <finalName>trader-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <!-- build-info lets /actuator/info and /api/system/info report the version and build time -->
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
