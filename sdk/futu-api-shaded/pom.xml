<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relocated build of the Futu OpenAPI Java SDK (a small standalone project, not part of the main reactor).

  Why it is needed: futu-api's protobuf generated code was produced by protoc 3.5.1, while the generated code
  bundled in IBKR TWS API 10.30 requires protobuf-java 4.x; the two cannot share one flat classpath
  (measured: under the 4.x runtime, com.futu.openapi.pb.Common fails with NoSuchMethodError as soon as it is
  initialized). This project packs futu-api and protobuf-java 3.5.1 into one jar and relocates
  com.google.protobuf to org.jdkxx.trader.shaded.futu.protobuf; the main project depends only on this artifact.

  Why it is not a reactor module: IDEA resolves reactor modules as source modules, so when running the
  application from the IDE the classpath would hold the original, unrelocated jar; a separately installed
  artifact makes the IDE and Maven see the same jar.

  Installation (once after cloning; when upgrading the SDK, change futu-api.version and re-run):
      ./scripts/install-sdks.sh            or            mvn -f sdk/futu-api-shaded/pom.xml install
  Keep <version> below and futu-api-shaded.version in the root pom in step with futu-api.version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jdkxx.trader</groupId>
    <artifactId>futu-api-shaded</artifactId>
    <!-- Kept equal to the futu-api version; referenced by futu-api-shaded.version in the main project's pom -->
    <version>10.10.7008</version>
    <packaging>jar</packaging>
    <name>futu-api-shaded</name>
    <description>com.futunn.openapi:futu-api + protobuf-java 3.5.1，protobuf 包重定位到 org.jdkxx.trader.shaded.futu.protobuf</description>

    <properties>
        <futu-api.version>10.10.7008</futu-api.version>
        <bouncycastle.version>1.68</bouncycastle.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.futunn.openapi</groupId>
            <artifactId>futu-api</artifactId>
            <version>${futu-api.version}</version>
        </dependency>
        <!--
          Transitive dependencies of futu-api. They must be declared here as direct dependencies: once shade
          packs futu-api into the jar it removes it from the dependency-reduced pom, its transitive
          dependencies disappear with it, and bcprov (used by the RSA-encrypted channel) is missing at runtime.
          They are deliberately not shaded in (only futu-api and protobuf-java are), so they stay ordinary
          dependencies of the installed artifact.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk15on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.futunn.openapi:futu-api</include>
                                    <include>com.google.protobuf:protobuf-java</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>org.jdkxx.trader.shaded.futu.protobuf</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
