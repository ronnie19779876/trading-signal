{
  "info": {
    "name": "trading-signal",
    "description": "trading-signal REST 接口。先选环境（dev / prod），变量：baseUrl、broker（ibkr|futu）、symbol。所有请求只读或只影响网关连接状态，不涉及交易。集合由 docs/postman/build_collection.py 生成，勿手改。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "系统",
      "item": [
        {
          "name": "系统信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/system/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system",
                "info"
              ]
            },
            "description": "版本、环境、数据库、两家网关状态、AI 配置状态。所有字段可公开展示。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"有版本与环境\", () => { pm.expect(body.version).to.be.a(\"string\"); pm.expect(body.environment).to.be.oneOf([\"DEV\",\"PROD\",\"未声明\"]); });",
                  "pm.test(\"两家网关\", () => { pm.expect(body.gateways).to.have.lengthOf(2); pm.expect(body.gateways[0].broker).to.eql(\"IBKR\"); pm.expect(body.gateways[1].broker).to.eql(\"FUTU\"); });",
                  "pm.test(\"数据库已启用且标记与环境一致\", () => { pm.expect(body.database.enabled).to.eql(true); pm.expect(body.database.marker).to.eql(body.environment); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "网关",
      "item": [
        {
          "name": "网关状态列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways"
              ]
            },
            "description": "两家网关的状态视图：state / detail / 心跳 / 重连次数 / facts。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"两家网关\", () => pm.expect(body).to.have.lengthOf(2));",
                  "body.forEach(g => pm.test(`${g.broker} 状态合法：${g.state}`, () => pm.expect(g.state).to.be.oneOf([\"DISABLED\",\"DISCONNECTED\",\"CONNECTING\",\"CONNECTED\",\"RECONNECTING\",\"ERROR\"])));",
                  "body.filter(g => g.enabled).forEach(g => pm.test(`${g.broker} 已启用则应 CONNECTED（当前 ${g.state}：${g.detail}）`, () => pm.expect(g.state).to.eql(\"CONNECTED\")));",
                  "body.filter(g => g.state === \"CONNECTED\").forEach(g => pm.test(`${g.broker} 心跳在 90 秒内`, () => pm.expect(Date.now() - Date.parse(g.lastHeartbeatAt)).to.be.below(90000)));",
                  "pm.test(\"facts 不含主机/端口/账户号\", () => body.forEach(g => Object.values(g.facts).forEach(v => { pm.expect(String(v)).to.not.match(/\\b(\\d{1,3}\\.){3}\\d{1,3}\\b/); pm.expect(String(v)).to.not.match(/\\bU\\d{7,8}\\b/); })));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "单个网关状态",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/{{broker}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "{{broker}}"
              ]
            },
            "description": "broker 取 ibkr / futu（环境变量 broker）。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"broker 匹配\", () => pm.expect(body.broker.toLowerCase()).to.eql(pm.environment.get(\"broker\").toLowerCase()));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "账户列表（脱敏）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/{{broker}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "{{broker}}",
                "accounts"
              ]
            },
            "description": "已连接时返回账户数组，账户号脱敏为前两位 + *****；未连接返回 503 GATEWAY_NOT_CONNECTED。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 或 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.test(\"至少一个账户且已脱敏\", () => { pm.expect(body.length).to.be.above(0); body.forEach(a => pm.expect(a.maskedId).to.match(/^.{2}\\*{5}$/)); }); }",
                  "if (pm.response.code === 503) { pm.test(\"未连接的错误码\", () => pm.expect(pm.response.json().code).to.eql(\"GATEWAY_NOT_CONNECTED\")); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "合约查询（盈透）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/ibkr/instruments?symbol={{symbol}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "ibkr",
                "instruments"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "{{symbol}}"
                }
              ]
            },
            "description": "reqContractDetails：返回 conId、名称、primaryExchange、minTick、时区、交易时段。查无此标的返回 []。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 或 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.test(\"有合约且带 conId 与 minTick\", () => { pm.expect(body.length).to.be.above(0); pm.expect(body[0].brokerRef).to.be.a(\"string\"); pm.expect(body[0].minTick).to.be.above(0); }); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "合约查询（查无此标的）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/ibkr/instruments?symbol=ZZZZNOSUCH",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "ibkr",
                "instruments"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "ZZZZNOSUCH"
                }
              ]
            },
            "description": "盈透错误 200（No security definition）映射为空数组。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 或 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "if (pm.response.code === 200) { pm.test(\"空数组\", () => pm.expect(pm.response.json()).to.eql([])); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "合约查询（富途不支持 → 400）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/futu/instruments?symbol=AAPL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "futu",
                "instruments"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "AAPL"
                }
              ]
            },
            "description": "本期只有盈透实现参考数据端口。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"PARAM_INVALID\", () => pm.expect(pm.response.json().code).to.eql(\"PARAM_INVALID\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "手工断开",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/{{broker}}/disconnect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "{{broker}}",
                "disconnect"
              ]
            },
            "description": "断开并停止重连。断开后看「网关状态列表」应为 DISCONNECTED，/actuator/health 为 DEGRADED（HTTP 仍 200）。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"状态为 DISCONNECTED 或 DISABLED\", () => pm.expect(body.state).to.be.oneOf([\"DISCONNECTED\",\"DISABLED\"]));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "手工连接",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/{{broker}}/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "{{broker}}",
                "connect"
              ]
            },
            "description": "发起连接（异步）。几秒后看「网关状态列表」应回到 CONNECTED；未启用的网关返回 400。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 或 400（未启用）\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "if (pm.response.code === 200) { pm.test(\"状态为 CONNECTING/RECONNECTING/CONNECTED\", () => pm.expect(pm.response.json().state).to.be.oneOf([\"CONNECTING\",\"RECONNECTING\",\"CONNECTED\"])); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "最近连接事件",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/events?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gateways",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "gateway_event 表最近 N 条：CONNECTED / RECONNECTED / DISCONNECTED / ERROR。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"是数组\", () => pm.expect(body).to.be.an(\"array\"));",
                  "body.forEach(e => pm.test(`事件类型合法：${e.broker} ${e.event}`, () => pm.expect(e.event).to.be.oneOf([\"CONNECTED\",\"RECONNECTED\",\"DISCONNECTED\",\"ERROR\"])));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "未知券商 → 400",
