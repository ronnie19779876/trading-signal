# Production secrets. Copy to trader.env and fill in the real values:
#     cp config/trader.env.example config/trader.env && chmod 600 config/trader.env
# WARNING: never commit trader.env to the repository, and never put its values in any document.
# The file is sourced by bin/trader.sh as shell code: quote values that contain spaces or shell characters.

# Database password. When empty, the service user's ~/.pgpass provides it
export TRADER_DB_PASSWORD=

# IBKR IB Gateway (each instance needs its own client-id; a clash reports 326). Enable: TRADER_IBKR_ENABLED=true
export TRADER_IBKR_ENABLED=false
export TRADER_IBKR_HOST=
export TRADER_IBKR_PORT=
export TRADER_IBKR_CLIENT_ID=
export TRADER_IBKR_ACCOUNT=

# Account snapshots (phase 3): HMAC key for account numbers (at least 16 characters; generate with
# openssl rand -hex 24; never change it once in use -- after a change, new snapshots of the same account get
# a different key). Cash-management instrument symbols, comma-separated: they go into snapshots only, never
# into the pool
export TRADER_ACCOUNT_KEY_SECRET=
export TRADER_ACCOUNT_CASH_EQUIVALENTS=

# Holdings risk panel (3.5.0): the most you are willing to lose, as a percentage of net liquidation value,
# on one symbol across an earnings report (e.g. 1 means 1%); your own choice. When unset, the
# "earnings over budget" check and the position-size conversion are skipped, and the budget item of the
# add-to-position check is recorded as "not evaluated"
# export TRADER_HOLDINGREVIEW_LOSSBUDGETPCT=

# Futu OpenD. Enable: TRADER_FUTU_ENABLED=true
export TRADER_FUTU_ENABLED=false
export TRADER_FUTU_HOST=
export TRADER_FUTU_PORT=

# OpenAI API key
export OPENAI_API_KEY=

# Optional: JVM options / a specific JDK (must be 21: the Futu SDK's protobuf 3.5.1 uses sun.misc.Unsafe;
# JDK 24+ warns, 26 throws)
# export JAVA_OPTS="-Xms256m -Xmx1g"
# export JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-amd64
