# 生产敏感配置。复制成 trader.env 并填入真实值：
#     cp config/trader.env.example config/trader.env && chmod 600 config/trader.env
# ⚠️ trader.env 不要提交到版本库，也不要出现在任何文档里。

# 数据库密码。留空则由服务用户的 ~/.pgpass 提供
export TRADER_DB_PASSWORD=

# 盈透 IB Gateway（第 1 期启用连接层时填写；client-id 生产 2，每个实例独占）
export TRADER_IBKR_HOST=
export TRADER_IBKR_PORT=
export TRADER_IBKR_CLIENT_ID=
export TRADER_IBKR_ACCOUNT=

# 富途 OpenD
export TRADER_FUTU_HOST=
export TRADER_FUTU_PORT=

# OpenAI API key
export OPENAI_API_KEY=

# 可选：JVM 参数 / 指定 JDK（必须是 21：富途 SDK 的 protobuf 3.5.1 用 sun.misc.Unsafe，JDK 24+ 告警、26 抛异常）
# export JAVA_OPTS="-Xms256m -Xmx1g"
# export JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-amd64
