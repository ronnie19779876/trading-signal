# Start at boot. Installation:
#   sudo cp systemd/trading-signal.service /etc/systemd/system/
#   sudo vi /etc/systemd/system/trading-signal.service   # set User / Group / WorkingDirectory
#   sudo systemctl daemon-reload && sudo systemctl enable --now trading-signal
# From then on manage it with systemctl only; do not call bin/trader.sh start/stop directly any more, or
# systemd's view of the state no longer matches the real process.
# Type=forking: trader.sh start launches the JVM in the background, writes the PID file, and returns once
# /actuator/health reports UP (within its own 90 s, below TimeoutStartSec).
[Unit]
Description=trading-signal
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=forking
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/trading-signal
PIDFile=/opt/trading-signal/logs/trading-signal.pid

ExecStart=/opt/trading-signal/bin/trader.sh start
ExecStop=/opt/trading-signal/bin/trader.sh stop
# No ExecReload: a restart inside reload stops the main process first, under Type=forking the unit becomes
# inactive, Restart=on-failure does not bring it back, and the process started during the reload gets
# cleaned up along with it. Always restart with systemctl restart.

TimeoutStartSec=120
# ExecStop goes through /actuator/shutdown and sends no signal; after TimeoutStopSec systemd falls back to
# SIGTERM, then SIGKILL
TimeoutStopSec=60

Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
